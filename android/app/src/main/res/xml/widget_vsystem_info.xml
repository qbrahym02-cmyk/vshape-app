<?xml version="1.0" encoding="utf-8"?>
<!-- Let the system re-render the widget at least every 30 min (Android
     floors anything below that), so it never shows numbers from the last
     app open. Every in-app tap still pushes immediately on top. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="130dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="115dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_vsystem"
    android:previewLayout="@layout/widget_vsystem"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
